# Database & Server
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flavoriz?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
CLIENT_URL=http://localhost:5000

# Nodemailer / Email Authentication (Optional - Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Cloudinary Cloud Storage (Optional - falls back to local uploads/ in dev)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Features (Optional)
# Chef Flavo Recipe Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Chef Flavo Recipe Auto-fill & Translation
GEMINI_API_KEY=
